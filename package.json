{
  "name": "kennykentola-multi-company",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --parallel",
    "init:appwrite": "npm run init:appwrite --workspace api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "turbo": "^2.9.18",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
