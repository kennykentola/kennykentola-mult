    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-appwrite": "^12.0.0",
    "pdfkit": "^0.18.0",
    "socket.io": "^4.7.5",
    "zod": "^3.22.0"
